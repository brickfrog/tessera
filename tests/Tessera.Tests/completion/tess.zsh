        ('deps') reply=('--depth:how many levels to follow (default 1; 0 = all the way)' '-d:how many levels to follow (default 1; 0 = all the way)' '--depends-on:only what the object depends on' '--referenced-by:only what refers to the object' '--unused:list hidden tables, columns, measures, hierarchies and functions nothing in the model uses' '--include-visible:with --unused: check visible objects too (reports may still use them)' '--kind:with --unused: only these kinds (repeatable or comma-separated), e.g. measure,column' '-k:with --unused: only these kinds (repeatable or comma-separated), e.g. measure,column' '--table:with --unused: only objects in this table (repeatable)' '-t:with --unused: only objects in this table (repeatable)' '--fail-on-unused:with --unused: exit 1 if anything is unused' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
        ('init') reply=('--name:model name' '-n:model name' '--compatibility-level:compatibility level (at least 1520)' '--format:output format: bim | tmdl | pbip' '-f:output format: bim | tmdl | pbip' '--culture:model culture, also used as the source query culture' '--force:overwrite a non-empty destination' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
