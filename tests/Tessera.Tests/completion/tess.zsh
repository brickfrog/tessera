#compdef tess
# zsh completion for tess. Generated by `tess completion zsh`: run it again after upgrading tess.

# Install: save it as _tess in a folder on $fpath (before compinit runs), or source it from ~/.zshrc
# after compinit.

_tess_children() {
    case $1 in
        ('') reply=('convert:convert a model between .bim, TMDL and PBIP' 'info:summarise a model' 'list:list the objects in a model' 'get:show one object (TMDL, or its JSON with --json)' 'find:search names, expressions, descriptions and other properties (exit 1: no matches)' 'diff:compare two models object by object (exit 1: they differ)' 'deps:what an object depends on, and what refers to it' 'init:create a new, empty semantic model' 'validate:check for broken references, circular references and other structural problems (exit 1: issues)' 'rename:rename an object and rewrite every DAX reference to it (dry run unless --save)' 'remove:remove objects, refusing while other DAX refers to them (dry run unless --save)' 'move:move a measure to another table, rewriting references that name its old table (dry run unless --save)' 'bpa:check the model against Best Practice Analyzer rules (exit 1: findings)' 'set:set properties on an object (dry run unless --save)' 'add:add a measure, column, table, hierarchy, relationship, role' 'translations:export translations to a CSV or JSON file for translators, import them back, or list cultures' 'perspective:add objects to a perspective, remove them from it, or list what it shows (dry run unless --save)' 'script:write DAX objects to a DAX script (export), or create and update them from one (apply)' 'lint:check DAX against code actions (unused variables, unqualified columns, IFERROR...) (exit 1: issues); --fix rewrites them' 'format:format DAX (SQLBI style, offline): stdin, --expr, a .dax file, or a model'\''s expressions (--check: exit 1 if any would change)' 'connect:check a connection to a server (powerbi://, asazure://, SSAS) and list its databases' 'query:run a DAX query on a server model (xmla:<server>;<database>), or offline on model files with --data <fixture>' 'deploy:deploy a model to a server: shows the changes and the TMSL script; --execute to run it' 'data:fixture data for the local DAX engine: create (init), check, summarize (info) or embed in a model a directory of CSV/JSON files' 'refresh:refresh a server model, or some tables or partitions: shows the TMSL script; --execute to run it' 'test:DAX tests for a model, from .tess-tests/*.test.yaml suites: run them offline over fixture data or on a server model (run), scaffold (init), record snapshots (snapshot), compare two models (compare)' 'completion:print a shell completion script for bash, zsh, fish or pwsh (see the README to install it)') ;;
        ('bpa') reply=('rules:list, show, add or remove rules, and ignore rules on objects: `tess bpa rules --help`') ;;
        ('bpa rules') reply=('list:list the rules in effect, with the layer each comes from and what it overrides' 'show:show one rule in full' 'add:add a rule to the model'\''s own rules or to a rule file (dry run unless --save)' 'remove:remove rules from the model'\''s own rules or from a rule file (dry run unless --save)' 'ignore:ignore a rule on objects (BestPracticeAnalyzer_IgnoreRules), or on the model to turn it off (dry run unless --save)' 'unignore:stop ignoring a rule on objects or the model (dry run unless --save)') ;;
        ('translations') reply=('export:write one row per object, culture and translatable property (caption, description, display folder), with the untranslated text and the translation, if any' 'import:set (or, where empty, remove) the translations in a file (dry run unless --save)' 'cultures:list the model'\''s cultures and how much of each is translated') ;;
        ('perspective') reply=('add:add objects to a perspective: a table with all its members, or single columns, measures and hierarchies (with their table)' 'remove:remove objects from a perspective: a table with all its members, or single members (a table whose last member goes is removed too)' 'list:list the perspectives, or the members of one') ;;
        ('script') reply=('export:write measures, calculated columns and tables, calculation groups and functions as a DAX script' 'apply:create or update the objects a DAX script defines; others are left alone (dry run unless --save)') ;;
        ('data') reply=('init:write a CSV file per table: the header row, or --rows N rows of synthetic data (refuses to overwrite without --force)' 'check:check a fixture against the model: files, columns, data types, keys and relationships (exit 1: errors)' 'info:list the fixture'\''s tables with row counts, and distinct and BLANK counts per column' 'embed:write a copy of the model whose loaded tables are calculated tables holding the fixture'\''s rows, so it can be deployed with no data source (refuses to overwrite without --force)') ;;
        ('test') reply=('run:run the suites'\'' tests against the model: offline over fixture data, or on a server model (exit 1: a test failed, or nothing was tested)' 'init:write a suite with one test per measure, to fill in (never overwrites a file)' 'snapshot:record the results of the suites'\'' snapshot tests next to the suites (dry run: shows what would change; --save writes)' 'compare:run the suites'\'' queries on the model and on --against (another version, or the deployed model) and report the differences (exit 1: differences)' 'list:check the suites and list their tests, without a model') ;;
        (*) reply=() ;;
    esac
}

_tess_options() {
    case $1 in
