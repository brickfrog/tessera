        ('list') reply=('--kind:only these kinds (repeatable or comma-separated), e.g. measure,column' '-k:only these kinds (repeatable or comma-separated), e.g. measure,column' '--table:only objects in this table (repeatable)' '-t:only objects in this table (repeatable)' '--name:only objects whose name matches this wildcard (* and ?), case-insensitive' '-n:only objects whose name matches this wildcard (* and ?), case-insensitive' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
        ('get') reply=('--property:print just this property (repeatable), e.g. expression, source.expression, annotations.PBI_FormatHint' '-p:print just this property (repeatable), e.g. expression, source.expression, annotations.PBI_FormatHint' '--children:include child objects (a table'\''s columns, measures, ...)' '--properties:list the properties `set` can write: path, type, value, and allowed values (enums)' '--all:with --properties: also list read-only properties' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
        ('find') reply=('--regex:treat the text as a .NET regular expression' '-E:treat the text as a .NET regular expression' '--case-sensitive:match case (default: case-insensitive)' '-s:match case (default: case-insensitive)' '--kind:only these kinds of object (repeatable or comma-separated)' '-k:only these kinds of object (repeatable or comma-separated)' '--table:only objects in this table (repeatable)' '-t:only objects in this table (repeatable)' '--in:only these properties: path wildcards, repeatable or comma-separated, e.g. expression, description, annotations.*' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
