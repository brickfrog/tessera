        ('convert') reply=('--format:output format: bim | tmdl | pbip' '-f:output format: bim | tmdl | pbip' '--force:overwrite a non-empty destination' '--eol:line endings: auto (default: match files already at the destination, else the source, else lf) | lf | crlf' '--indent-spaces:indent TMDL with this many spaces instead of tabs' '--include-sensitive:keep restricted information such as data source passwords' '--json:write machine-readable JSON to stdout' '-j:write machine-readable JSON to stdout' '--help:display this list of options' '-h:display this list of options') ;;
