# fish completion for tess. Generated by `tess completion fish`: run it again after upgrading tess.

# Install: save it as ~/.config/fish/completions/tess.fish.

function __tess_children
    switch $argv[1]
        case ''
            printf '%s\t%s\n' 'convert' 'convert a model between .bim, TMDL, PBIP and database.json folders'
            printf '%s\t%s\n' 'info' 'summarise a model'
            printf '%s\t%s\n' 'list' 'list the objects in a model'
            printf '%s\t%s\n' 'get' 'show one object (TMDL, or its JSON with --json)'
            printf '%s\t%s\n' 'find' 'search names, expressions, descriptions and other properties (exit 1: no matches)'
            printf '%s\t%s\n' 'diff' 'compare two models object by object (exit 1: they differ)'
            printf '%s\t%s\n' 'deps' 'what an object depends on, and what refers to it'
            printf '%s\t%s\n' 'init' 'create a new, empty semantic model'
            printf '%s\t%s\n' 'validate' 'check for broken references, circular references and other structural problems (exit 1: issues)'
            printf '%s\t%s\n' 'rename' 'rename an object and rewrite every DAX reference to it (dry run unless --save)'
            printf '%s\t%s\n' 'remove' 'remove objects, refusing while other DAX refers to them (dry run unless --save)'
            printf '%s\t%s\n' 'move' 'move a measure to another table, rewriting references that name its old table (dry run unless --save)'
            printf '%s\t%s\n' 'bpa' 'check the model against Best Practice Analyzer rules (exit 1: findings)'
            printf '%s\t%s\n' 'set' 'set properties on an object (dry run unless --save)'
            printf '%s\t%s\n' 'add' 'add a measure, column, table, hierarchy, relationship, role'
            printf '%s\t%s\n' 'translations' 'export translations to a CSV or JSON file for translators, import them back, or list cultures'
            printf '%s\t%s\n' 'perspective' 'add objects to a perspective, remove them from it, or list what it shows (dry run unless --save)'
            printf '%s\t%s\n' 'script' 'write DAX objects to a DAX script (export), or create and update them from one (apply)'
            printf '%s\t%s\n' 'lint' 'check DAX against code actions (unused variables, unqualified columns, IFERROR...) (exit 1: issues); --fix rewrites them'
            printf '%s\t%s\n' 'format' 'format DAX (SQLBI style, offline): stdin, --expr, a .dax file, or a model\'s expressions (--check: exit 1 if any would change)'
            printf '%s\t%s\n' 'connect' 'check a connection to a server (powerbi://, asazure://, SSAS) and list its databases'
            printf '%s\t%s\n' 'query' 'run a DAX query on a server model (xmla:<server>;<database>), or offline on model files with --data <fixture>'
            printf '%s\t%s\n' 'deploy' 'deploy a model to a server: shows the changes and the TMSL script; --execute to run it'
            printf '%s\t%s\n' 'data' 'fixture data for the local DAX engine: create (init), check, summarize (info) or embed in a model a directory of CSV/JSON files'
            printf '%s\t%s\n' 'refresh' 'refresh a server model, or some tables or partitions: shows the TMSL script; --execute to run it'
            printf '%s\t%s\n' 'test' 'DAX tests for a model, from .tess-tests/*.test.yaml suites: run them offline over fixture data or on a server model (run), scaffold (init), record snapshots (snapshot), compare two models (compare)'
            printf '%s\t%s\n' 'completion' 'print a shell completion script for bash, zsh, fish or pwsh (see the README to install it)'
        case 'bpa'
            printf '%s\t%s\n' 'rules' 'list, show, add or remove rules, and ignore rules on objects: `tess bpa rules --help`'
        case 'bpa rules'
            printf '%s\t%s\n' 'list' 'list the rules in effect, with the layer each comes from and what it overrides'
            printf '%s\t%s\n' 'show' 'show one rule in full'
            printf '%s\t%s\n' 'add' 'add a rule to the model\'s own rules or to a rule file (dry run unless --save)'
            printf '%s\t%s\n' 'remove' 'remove rules from the model\'s own rules or from a rule file (dry run unless --save)'
            printf '%s\t%s\n' 'ignore' 'ignore a rule on objects (BestPracticeAnalyzer_IgnoreRules), or on the model to turn it off (dry run unless --save)'
            printf '%s\t%s\n' 'unignore' 'stop ignoring a rule on objects or the model (dry run unless --save)'
        case 'translations'
            printf '%s\t%s\n' 'export' 'write one row per object, culture and translatable property (caption, description, display folder), with the untranslated text and the translation, if any'
            printf '%s\t%s\n' 'import' 'set (or, where empty, remove) the translations in a file (dry run unless --save)'
            printf '%s\t%s\n' 'cultures' 'list the model\'s cultures and how much of each is translated'
        case 'perspective'
            printf '%s\t%s\n' 'add' 'add objects to a perspective: a table with all its members, or single columns, measures and hierarchies (with their table)'
            printf '%s\t%s\n' 'remove' 'remove objects from a perspective: a table with all its members, or single members (a table whose last member goes is removed too)'
            printf '%s\t%s\n' 'list' 'list the perspectives, or the members of one'
        case 'script'
            printf '%s\t%s\n' 'export' 'write measures, calculated columns and tables, calculation groups and functions as a DAX script'
            printf '%s\t%s\n' 'apply' 'create or update the objects a DAX script defines; others are left alone (dry run unless --save)'
        case 'data'
            printf '%s\t%s\n' 'init' 'write a CSV file per table: the header row, or --rows N rows of synthetic data (refuses to overwrite without --force)'
            printf '%s\t%s\n' 'check' 'check a fixture against the model: files, columns, data types, keys and relationships (exit 1: errors)'
            printf '%s\t%s\n' 'info' 'list the fixture\'s tables with row counts, and distinct and BLANK counts per column'
            printf '%s\t%s\n' 'embed' 'write a copy of the model whose loaded tables are calculated tables holding the fixture\'s rows, so it can be deployed with no data source (refuses to overwrite without --force)'
        case 'test'
            printf '%s\t%s\n' 'run' 'run the suites\' tests against the model: offline over fixture data, or on a server model (exit 1: a test failed, or nothing was tested)'
            printf '%s\t%s\n' 'init' 'write a suite with one test per measure, to fill in (never overwrites a file)'
            printf '%s\t%s\n' 'snapshot' 'record the results of the suites\' snapshot tests next to the suites (dry run: shows what would change; --save writes)'
            printf '%s\t%s\n' 'compare' 'run the suites\' queries on the model and on --against (another version, or the deployed model) and report the differences (exit 1: differences)'
            printf '%s\t%s\n' 'list' 'check the suites and list their tests, without a model'
    end
end

