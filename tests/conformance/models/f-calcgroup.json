     "A",
     10
    ],
    [
     "B",
     20
    ],
    [
     "C",
     30
    ]
   ]
  }
 ],
 "calculationGroups": [
  {
   "name": "Adjust",
   "column": "Adjustment",
   "precedence": 100,
   "items": [
    {
     "name": "Current",
     "expression": "SELECTEDMEASURE ()"
    },
    {
     "name": "Plus 2",
     "expression": "SELECTEDMEASURE () + 2"
    },
    {
     "name": "Only Total x10",
     "expression": "IF ( ISSELECTEDMEASURE ( [Total] ), SELECTEDMEASURE () * 10, SELECTEDMEASURE () )"
