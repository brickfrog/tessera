{
  "description": "Like a tiny sales model, but two Sales rows have a ProductKey (9) that Product doesn't have, so Product gets the blank row. Amount: Bike 100, Lock 30, orphans 70 (50 + 20); total 200.",
  "tables": [
    { "name": "Product",
      "columns": [
        { "name": "ProductKey", "type": "int64", "key": true },
        { "name": "Product", "type": "string" },
        { "name": "Color", "type": "string" } ],
      "rows": [ [1, "Bike", "Red"], [2, "Lock", "Blue"], [3, "Bell", "Red"] ] },
    { "name": "Sales",
      "columns": [
        { "name": "SalesKey", "type": "int64" },
        { "name": "ProductKey", "type": "int64" },
        { "name": "Amount", "type": "decimal" } ],
      "measures": [ { "name": "Sales Amount", "expression": "SUM ( Sales[Amount] )" } ],
      "rows": [ [1, 1, 100.0], [2, 2, 30.0], [3, 9, 50.0], [4, 9, 20.0] ] }
  ],
  "relationships": [ { "from": "Sales[ProductKey]", "to": "Product[ProductKey]" } ]
}
