          "Vehicles",
          "Bike",
          100.0
        ],
        [
          "Vehicles",
          "Scooter",
          50.0
        ]
      ]
    }
  ],
  "ordered": true,
  "source": {
    "url": "https://dax.guide/st/order-by/",
    "quote": "Every column can be sorted in an ascending (ASC) or descending (DESC) way. The default is ASC.",
