{
  "title": "ORDER BY sorts by the first key, then by the second, each in its own direction",
  "model": "sales",
  "query": [
    "EVALUATE",
    "SELECTCOLUMNS ( Product, \"Category\", Product[Category], \"Product\", Product[Product], \"Price\", Product[Price] )",
    "ORDER BY [Category] ASC, [Price] DESC"
  ],
  "expected": [
    {
      "columns": [
