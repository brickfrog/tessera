          "Scooter"
        ],
        [
          4,
          "Scooter",
          "Green",
          "Vehicles",
          50.0,
          null
        ]
      ]
    }
  ],
  "source": {
    "url": "https://dax.guide/offset/",
    "quote": "The number of rows before (negative value) or after (positive value) the current row from which to obtain the data.",
    "supports": "a delta of 1 is the row after the current one"
  },
  "confidence": "derived",
  "derivation": "Ordered by ProductKey: Bike, Helmet, Lock, Scooter. The row after Bike is Helmet, after Helmet Lock, after Lock Scooter. Scooter is last: OFFSET returns an empty table and MAXX over no rows is BLANK.",
