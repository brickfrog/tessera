{
  "title": "OFFSET past the last row returns no row",
  "model": "sales",
  "query": [
    "EVALUATE",
    "ADDCOLUMNS (",
    "    'Product',",
    "    \"Next\", MAXX ( OFFSET ( 1, 'Product', ORDERBY ( 'Product'[ProductKey], ASC ) ), 'Product'[Product] )",
    ")"
  ],
  "expected": [
    {
      "columns": [
        {
          "name": "Product[ProductKey]",
          "type": "int64"
        },
        {
          "name": "Product[Product]",
          "type": "string"
        },
        {
          "name": "Product[Color]",
          "type": "string"
        },
        {
          "name": "Product[Category]",
          "type": "string"
        },
        {
          "name": "Product[Price]",
          "type": "decimal"
        },
        {
          "name": "[Next]",
          "type": "string"
        }
      ],
      "rows": [
        [
          1,
          "Bike",
          "Red",
          "Vehicles",
          100.0,
          "Helmet"
        ],
        [
          2,
          "Helmet",
          "Red",
          "Accessories",
          20.0,
          "Lock"
        ],
        [
          3,
          "Lock",
          "Blue",
          "Accessories",
