{
  "title": "WINDOW ( -1, REL, 0, REL ) is the previous row and the current one",
  "model": "sales",
  "query": [
    "EVALUATE",
    "ADDCOLUMNS (",
    "    'Product',",
    "    \"Pair\", SUMX ( WINDOW ( -1, REL, 0, REL, 'Product', ORDERBY ( 'Product'[ProductKey], ASC ) ), 'Product'[Price] )",
    ")"
  ],
  "expected": [
    {
      "columns": [
        {
          "name": "Product[ProductKey]",
          "type": "int64"
        },
        {
