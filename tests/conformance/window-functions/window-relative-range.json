        },
        {
          "name": "Product[Color]",
          "type": "string"
        },
        {
          "name": "Product[Category]",
          "type": "string"
        },
        {
          "name": "Product[Price]",
          "type": "decimal"
        },
        {
          "name": "[Pair]",
          "type": "decimal"
        }
      ],
      "rows": [
        [
          1,
          "Bike",
