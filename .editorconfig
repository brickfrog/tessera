root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,props,fsproj,slnx,yml,yaml}]
indent_size = 2

[*.{fs,fsx,fsi}]
max_line_length = 120
fsharp_multiline_bracket_style = stroustrup
fsharp_keep_max_number_of_blank_lines = 2
