<Project Sdk="Microsoft.NET.Sdk">

  <!-- A benchmark of the local DAX engine on a real model (see bench/README.md). Not part of the
       solution, the tests or CI: build and run it by hand. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Tessera.Core/Tessera.Core.fsproj" />
  </ItemGroup>

</Project>
