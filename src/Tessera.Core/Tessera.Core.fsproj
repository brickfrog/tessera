<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Tessera</RootNamespace>
    <Description>Core library for tessera: load, inspect and save Power BI / Analysis Services semantic models.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Errors.fs" />
    <Compile Include="ObjectRef.fs" />
    <Compile Include="Pbip.fs" />
    <Compile Include="XmlaAddress.fs" />
    <Compile Include="ModelSource.fs" />
    <Compile Include="ModelIO.fs" />
    <Compile Include="Scaffold.fs" />
    <Compile Include="Inventory.fs" />
    <Compile Include="Serialize.fs" />
    <Compile Include="Find.fs" />
    <Compile Include="Diff.fs" />
    <Compile Include="Dax.fs" />
    <Compile Include="DaxAst.fs" />
    <Compile Include="DaxParser.fs" />
    <Compile Include="DaxPrinter.fs" />
    <Compile Include="Deps.fs" />
    <Compile Include="Validate.fs" />
    <Compile Include="Rename.fs" />
    <Compile Include="BpaRules.fs" />
    <Compile Include="BpaDaxToken.fs" />
    <Compile Include="BpaObjects.fs" />
    <Compile Include="Bpa.fs" />
    <Compile Include="ChangeSet.fs" />
    <Compile Include="Mutation.fs" />
    <Compile Include="SetProperty.fs" />
    <Compile Include="AddObject.fs" />
    <Compile Include="RemoveObject.fs" />
    <Compile Include="MoveObject.fs" />
    <Compile Include="Translations.fs" />
    <Compile Include="Perspectives.fs" />
    <Compile Include="Unused.fs" />
    <Compile Include="DaxScript.fs" />
    <Compile Include="ExportScript.fs" />
    <Compile Include="ApplyScript.fs" />
    <Compile Include="Lint.fs" />
    <Compile Include="BpaRuleEdit.fs" />
    <Compile Include="BpaFetch.fs" />
    <Compile Include="Report.fs" />
    <Compile Include="Format.fs" />
    <Compile Include="QueryResult.fs" />
    <Compile Include="Deploy.fs" />
    <Compile Include="DaxValue.fs" />
    <Compile Include="DataStore.fs" />
    <Compile Include="Fixture.fs" />
    <Compile Include="FixtureInit.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BpaRules.json" LogicalName="Tessera.BpaRules.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AnalysisServices" Version="19.118.3" />
    <!-- Apache-2.0. Evaluates BPA rule expressions (Dynamic LINQ, as Tabular Editor uses). -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
  </ItemGroup>

</Project>
