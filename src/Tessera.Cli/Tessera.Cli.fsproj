<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tess</AssemblyName>
    <RootNamespace>Tessera.Cli</RootNamespace>
    <Description>tess: a cross-platform command line for Power BI / Analysis Services semantic models.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tess</ToolCommandName>
    <PackageId>tessera</PackageId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Output.fs" />
    <Compile Include="Common.fs" />
    <Compile Include="Source.fs" />
    <Compile Include="Findings.fs" />
    <Compile Include="Sarif.fs" />
    <Compile Include="Changes.fs" />
    <Compile Include="Mutation.fs" />
    <Compile Include="Watch.fs" />
    <Compile Include="Commands/InfoCommand.fs" />
    <Compile Include="Commands/ListCommand.fs" />
    <Compile Include="Commands/GetCommand.fs" />
    <Compile Include="Commands/FindCommand.fs" />
    <Compile Include="Commands/DiffCommand.fs" />
    <Compile Include="Commands/DepsCommand.fs" />
    <Compile Include="Commands/ConvertCommand.fs" />
    <Compile Include="Commands/InitCommand.fs" />
    <Compile Include="Commands/ValidateCommand.fs" />
    <Compile Include="Commands/RenameCommand.fs" />
    <Compile Include="Commands/RemoveCommand.fs" />
    <Compile Include="Commands/MoveCommand.fs" />
    <Compile Include="Commands/BpaRulesCommand.fs" />
    <Compile Include="Commands/BpaCommand.fs" />
    <Compile Include="Commands/SetCommand.fs" />
    <Compile Include="Commands/AddCommand.fs" />
    <Compile Include="Commands/TranslationsCommand.fs" />
    <Compile Include="Commands/PerspectiveCommand.fs" />
    <Compile Include="Commands/ScriptCommand.fs" />
    <Compile Include="Commands/LintCommand.fs" />
    <Compile Include="Commands/FormatCommand.fs" />
    <Compile Include="Commands/ConnectCommand.fs" />
    <Compile Include="Commands/QueryCommand.fs" />
    <Compile Include="Commands/DeployCommand.fs" />
    <Compile Include="Commands/DataCommand.fs" />
    <Compile Include="Commands/RefreshCommand.fs" />
    <Compile Include="Commands/TestCommand.fs" />
    <Compile Include="Commands/WatchCommands.fs" />
    <Compile Include="Commands/CompletionCommand.fs" />
    <!-- New commands: add Commands/<Name>Command.fs above, a case in Args.fs, a line in App.fs. -->
    <Compile Include="Args.fs" />
    <Compile Include="App.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- Release binaries: self-contained single-file publishes per runtime (see .github/workflows/release.yml).
       Not trimmed: TOM and its serializers rely on reflection. -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!-- TOM pulls in MSAL's native broker (libmsalruntime.so / msalruntime*.dll / .dylib, ~37 MB), which
       only its own interactive (WAM) sign-in on Windows uses. tess never takes that path: it always
       hands the client library a credential (an access token, a service principal, a password, or a
       token from its own device-code sign-in through managed MSAL), or uses Windows integrated
       security for SSAS. So leave the broker out of single-file publishes: bundling it would force
       self-extraction to ~/.net, which fails without a writable HOME. Likewise msasxpress.dll
       (optional XMLA transport compression on Windows; the client library works without it and
       can't find it in a single-file app anyway). Revisit if tess ever offers interactive sign-in. -->
  <Target Name="TessExcludeMsalRuntime" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').Contains('msalruntime'))" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').Contains('msasxpress'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Ship licensing in the tool package: our MIT license and the bundled components' terms. -->
    <None Include="../../LICENSE" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../licenses/*" Pack="true" PackagePath="licenses/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Tessera.Core/Tessera.Core.fsproj" />
    <ProjectReference Include="../Tessera.Xmla/Tessera.Xmla.fsproj" />
  </ItemGroup>

</Project>
